# Copy to /home/ubuntu/noticore/.env on the server and fill in. Never commit the real file.
# Wrap a value in single quotes if it contains $ or #.

# Public hostname that points at the server, without https://
APP_DOMAIN=your-label.your-region.cloudapp.azure.com

DB_USERNAME=noticore
DB_PASSWORD=

RABBITMQ_USERNAME=noticore
RABBITMQ_PASSWORD=

BREVO_API_KEY=
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
BREVO_WEBHOOK_USERNAME=
BREVO_WEBHOOK_PASSWORD=

# Must match the proxy secret shown in the RapidAPI provider dashboard
RAPIDAPI_PROXY_SECRET=
